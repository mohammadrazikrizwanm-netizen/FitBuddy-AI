# ==========================================
# FITBUDDY ENVIRONMENT CONFIGURATION
# ==========================================

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here


# Gemini models
#
# Change these if the model available
# in your Google AI account is different.

GEMINI_WORKOUT_MODEL=gemini-2.5-flash

GEMINI_TIP_MODEL=gemini-2.5-flash


# ==========================================
# DEMO MODE
# ==========================================

# true = application works without Gemini API
# false = real Gemini API required

DEMO_MODE=true


# ==========================================
# ADMIN
# ==========================================

ADMIN_KEY=fitbuddy-admin


# ==========================================
# APPLICATION
# ==========================================

APP_NAME=FitBuddy

DATABASE_URL=sqlite:///./fitbuddy.db